{
  "expo": {
    "name": "PaceHub",
    "slug": "pacehub",
    "scheme": "pacehub",
    "version": "0.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.pacehub.app"
    },
    "android": {
      "package": "br.com.pacehub.app"
    },
    "web": {
      "bundler": "metro"
    }
  }
}

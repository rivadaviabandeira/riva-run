# Copie este arquivo para .env.local e preencha com os valores do seu projeto Supabase.
# Use apenas a Project URL e a Publishable key (sb_publishable_...) no app.
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUA_CHAVE_PUBLICA

# Nunca coloque aqui service_role, secret key, senha do banco ou tokens do Strava.
